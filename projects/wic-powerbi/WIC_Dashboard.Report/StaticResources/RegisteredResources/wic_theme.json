{
  "name": "WIC Dashboard",
  "dataColors": [
    "#2E6DA4",
    "#76A5D0",
    "#B9D3EA",
    "#5D6D7E",
    "#C5CBD3",
    "#E67E22",
    "#16A085",
    "#8E44AD"
  ],
  "background": "#FFFFFF",
  "foreground": "#1C2833",
  "tableAccent": "#2E6DA4",
  "good": "#1E8449",
  "neutral": "#B9770E",
  "bad": "#B03A2E",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#1C2833"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1C2833"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1C2833"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#566573"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D5D8DC"
              }
            },
            "radius": 6
          }
        ]
      }
    }
  }
}