{
  "name": "WIC Dashboard",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#5D6D7E",
    "#C5CBD3",
    "#EDA100",
    "#6250D6",
    "#E34948"
  ],
  "background": "#FFFFFF",
  "foreground": "#1C2833",
  "tableAccent": "#2A78D6",
  "good": "#1E8449",
  "neutral": "#B9770E",
  "bad": "#B03A2E",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#1C2833"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1C2833"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1C2833"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#566573"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E6EA"
              }
            },
            "radius": 10
          }
        ]
      }
    }
  }
}